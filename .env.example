# ============================================================
# Vaani AI - Configuration Settings
# ============================================================

# Bot handle (without @)
BOT_HANDLE=vaaniai

# Hugging Face Execution Mode:
# Options:
#   - 'local': Uses local transformers pipeline (downloads weights or uses local path)
#   - 'inference_api': Uses Hugging Face Serverless Inference API (fast, needs HF_TOKEN)
#   - 'mock': Generates mock replies for instant offline development and testing
HF_MODE=local

# Model ID or local path (e.g. 'Qwen/Qwen2.5-0.5B-Instruct', 'Qwen/Qwen2.5-1.5B-Instruct', or path to fine-tuned model)
HF_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct

# Hugging Face Token (required if using 'inference_api' or gated HF models)
# Get yours at https://huggingface.co/settings/tokens
HF_TOKEN=

# Device for local inference: 'cpu' or 'cuda'
HF_DEVICE=cpu

# Path to local LoRA adapter weights (optional, if you have a fine-tuned LoRA checkpoint)
HF_LORA_PATH=

# Max tokens to generate
MAX_NEW_TOKENS=150
TEMPERATURE=0.7

# Polling Interval (in seconds) for Twitter mentions
POLL_INTERVAL_SECONDS=30

# Twitter / X API v2 Credentials (Required only for live bot mode)
# Create a developer project at https://developer.x.com
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# Database & Data Paths
DATABASE_PATH=data/vaani.db
DATASET_PATH=data/dataset.jsonl
